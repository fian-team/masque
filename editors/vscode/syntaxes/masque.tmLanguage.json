{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Masque",
  "scopeName": "source.masque",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#function-keyword" },
    { "include": "#type-annotations" },
    { "include": "#operators" },
    { "include": "#widget-name" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.masque",
          "match": "//.*$"
        },
        {
          "name": "comment.block.masque",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.masque",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.masque",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.masque",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.masque",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.masque",
      "match": "\\b(true|false)\\b"
    },
    "keywords": {
      "name": "keyword.control.masque",
      "match": "\\b(let|state|if|else|return|for|in|match|import|from|log)\\b"
    },
    "function-keyword": {
      "name": "keyword.other.fn.masque",
      "match": "\\bfn\\b"
    },
    "type-annotations": {
      "name": "storage.type.masque",
      "match": "(?<=:\\s{0,8})\\b(int|string|float|bool|widget|void)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.masque",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.masque",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arrow.masque",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.masque",
          "match": "="
        },
        {
          "name": "keyword.operator.spread.masque",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.masque",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.increment.masque",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.arithmetic.masque",
          "match": "[+\\-*/%^]"
        }
      ]
    },
    "widget-name": {
      "match": "\\b([A-Z][a-zA-Z0-9]*)\\s*\\{",
      "captures": {
        "1": { "name": "entity.name.type.widget.masque" }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.masque",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.bracket.masque",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.paren.masque",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.masque",
          "match": "[;,]"
        },
        {
          "name": "punctuation.separator.colon.masque",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.masque",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.masque",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
