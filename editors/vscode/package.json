{
  "name": "masque-lang",
  "displayName": "Masque Language",
  "description": "Language support for the Masque UI language (.masque files)",
  "version": "0.1.0",
  "publisher": "fian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fian-team/masque"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:masque"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "masque",
        "aliases": ["Masque", "masque"],
        "extensions": [".masque"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "masque",
        "scopeName": "source.masque",
        "path": "./syntaxes/masque.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Masque",
      "properties": {
        "masque.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the masque-lsp binary. Leave empty to use 'masque-lsp' from PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
